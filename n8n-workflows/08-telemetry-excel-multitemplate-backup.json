    {
      "parameters": {
        "jsCode": "const MONTHS = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];\n\nlet reportType;\nfor (const n of ['Tipe Harian', 'Tipe Mingguan', 'Tipe Bulanan']) {\n  try {\n    const it = $(n).first();\n    if (it) { reportType = it.json.reportType; break; }\n  } catch (e) {}\n}\nif (!reportType) reportType = 'DAILY';\n\nconst now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Jakarta' }));\nlet targetDate = now;\n\nif (reportType === 'DAILY') {\n  targetDate = new Date(now.getTime() - 24 * 3600 * 1000); // kemarin (T-1)\n} else if (reportType === 'WEEKLY') {\n  targetDate = new Date(now.getTime() - 24 * 3600 * 1000); // pekan yang berakhir kemarin (Sabtu)\n} else if (reportType === 'MONTHLY') {\n  targetDate = new Date(now.getFullYear(), now.getMonth() - 1, 1); // bulan lalu\n}\n\nconst targetMonth = MONTHS[targetDate.getMonth()].toLowerCase();\nconst targetYear = String(targetDate.getFullYear());\nconst currentMonth = MONTHS[now.getMonth()].toLowerCase();\nconst currentYear = String(now.getFullYear());\n\nconst files = $input.first().json.files || [];\n\n// 1. Cari file spreadsheet di folder yang namanya memuat [BulanTarget] dan [TahunTarget]\nlet selected = files.find(f => {\n  const n = (f.name || '').toLowerCase();\n  return n.includes(targetMonth) && n.includes(targetYear);\n});\n\n// 2. Fallback: jika bulan lalu belum ada (misal testing di bulan berjalan), cari file bulan berjalan\nif (!selected) {\n  selected = files.find(f => {\n    const n = (f.name || '').toLowerCase();\n    return n.includes(currentMonth) && n.includes(currentYear);\n  });\n}\n\n// 3. Fallback: ambil file spreadsheet terbaru di folder\nif (!selected && files.length > 0) {\n  selected = files[0];\n}\n\nconst spreadsheetId = selected ? selected.id : 'YOUR_SPREADSHEET_ID';\nconst spreadsheetName = selected ? selected.name : 'Master Metering';\n\nreturn [{ json: {\n  spreadsheetId,\n  spreadsheetName,\n  reportType,\n  targetMonth,\n  targetYear\n} }];"
      },
      "id": "42c140f2-f54d-49d5-a6d5-4cc110136b5c",
      "name": "Pilih Spreadsheet Bulan Target",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        64
      ]
    },
    {
      "parameters": {
        "url": "={{ 'https://sheets.googleapis.com/v4/spreadsheets/' + $json.spreadsheetId + '?fields=sheets.properties.title' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {
          "timeout": 120000
        }
      },
      "id": "ab581eba-ee1b-41c8-b42b-5dd0d36662d6",
      "name": "Ambil Daftar Nama Sheet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        896,
        64
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "YOUR_GOOGLE_CREDENTIAL_NAME"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const TEMPLATES = {\n  DAILY: 'YOUR_DAILY_TEMPLATE_SPREADSHEET_ID',\n  WEEKLY: 'YOUR_WEEKLY_TEMPLATE_SPREADSHEET_ID',\n  MONTHLY_5W: 'YOUR_MONTHLY_TEMPLATE_SPREADSHEET_ID',\n  MONTHLY_4W: 'YOUR_MONTHLY_4W_TEMPLATE_SPREADSHEET_ID'\n};\nconst MONTHS = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];\n\nconst meta = $('Pilih Spreadsheet Bulan Target').first().json;\nconst spreadsheetId = meta.spreadsheetId;\nlet reportType = meta.reportType;\n\nconst now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Jakarta' }));\nconst titles = ($input.first().json.sheets || []).map(s => s.properties.title);\nconst low = t => String(t).trim().toLowerCase();\nconst pad = n => String(n).padStart(2, '0');\nlet sheetName = null;\n\nif (reportType === 'DAILY') {\n  const y = new Date(now.getTime() - 24 * 3600 * 1000);\n  const d = y.getDate(), m = y.getMonth() + 1, yr = y.getFullYear();\n  const cands = [\n    d + '/' + m + '/' + yr,\n    pad(d) + '/' + pad(m) + '/' + yr,\n    d + '-' + m + '-' + yr,\n    pad(d) + '-' + pad(m) + '-' + yr\n  ].map(low);\n  sheetName = titles.find(t => cands.includes(low(t))) || null;\n\n} else if (reportType === 'MONTHLY') {\n  const pm = new Date(now.getFullYear(), now.getMonth() - 1, 1);\n  const targetPrev = low(MONTHS[pm.getMonth()] + ' ' + pm.getFullYear());\n  const targetCurr = low(MONTHS[now.getMonth()] + ' ' + now.getFullYear());\n\n  sheetName = titles.find(t => low(t) === targetPrev)\n           || titles.find(t => low(t) === targetCurr)\n           || titles.find(t => MONTHS.some(m => low(t) === low(m + ' ' + now.getFullYear())))\n           || null;\n\n  // Cek apakah ada tab MINGGU 5 di workbook bulan ini\n  const hasMinggu5 = titles.some(t => {\n    const u = t.toUpperCase().trim();\n    return u.includes('MINGGU 5') || u.includes('MINGGU-5') || u.includes('MINGGU_5') || u.includes('WEEK 5');\n  });\n\n  reportType = hasMinggu5 ? 'MONTHLY_5W' : 'MONTHLY_4W';\n\n} else {\n  const sat = new Date(now.getTime() - 24 * 3600 * 1000);\n  const sun = new Date(now.getTime() - 7 * 24 * 3600 * 1000);\n  const seen = [];\n  for (const r of [sat, sun]) {\n    const w = Math.ceil(r.getDate() / 7);\n    const m = r.getMonth() + 1, yr = r.getFullYear();\n    const tail = ['/' + m + '/' + yr, '-' + m + '-' + yr];\n    const key = 'MINGGU ' + w;\n    seen.push(key + ' ' + m + '/' + yr);\n    const hit = titles.find(t => {\n      const u = t.toUpperCase();\n      const i = u.indexOf(key);\n      if (i < 0) return false;\n      const next = u.charAt(i + key.length);\n      if (next >= '0' && next <= '9') return false;\n      return tail.some(x => t.indexOf(x) >= 0);\n    });\n    if (hit) { sheetName = hit; break; }\n  }\n  if (!sheetName) {\n    throw new Error('Tab mingguan tidak ditemukan. Dicari: ' + seen.join(' / ') + '. Daftar sheet: ' + titles.slice(0, 60).join(' | '));\n  }\n}\n\nif (!sheetName) {\n  throw new Error('Sheet target tidak ditemukan untuk tipe ' + reportType + '. Daftar sheet: ' + titles.slice(0, 60).join(' | '));\n}\n\n// Bounded ranges\nconst RANGES = {\n  DAILY: 'A1:AB550',      // 28 kolom\n  WEEKLY: 'A1:R550',       // 18 kolom\n  MONTHLY_5W: 'A1:N550',   // 14 kolom (5 minggu)\n  MONTHLY_4W: 'A1:L550'    // 12 kolom (4 minggu)\n};\nconst targetRange = RANGES[reportType] || 'A1:AB550';\nconst fullRange = \"'\" + sheetName + \"'!\" + targetRange;\n\nconst ts = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate()) + '_' + pad(now.getHours()) + '-' + pad(now.getMinutes());\nconst safe = sheetName.replace(/[\\/\\\\:*?\"<>|]/g, '-').trim();\n\nreturn [{ json: {\n  spreadsheetId,\n  sheetName,\n  range: fullRange,\n  reportType,\n  templateId: TEMPLATES[reportType] || TEMPLATES.MONTHLY_5W,\n  fileName: 'Laporan_' + safe + '_' + ts + '.xlsx'\n} }];"
      },
