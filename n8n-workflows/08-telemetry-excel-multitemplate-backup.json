    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nif (j.body && j.body.tableData) {\n  return [{ json: j }];\n}\nconst t = $('Tentukan Nama Sheet').first().json;\nif (!j.values || j.values.length === 0) {\n  throw new Error('Sheet ' + t.sheetName + ' kosong, backup dibatalkan');\n}\nreturn [{ json: { body: {\n  spreadsheetId: t.spreadsheetId,\n  sheetName: t.sheetName,\n  reportType: t.reportType,\n  templateId: t.templateId,\n  fileName: t.fileName,\n  tableData: j.values || []\n} } }];"
