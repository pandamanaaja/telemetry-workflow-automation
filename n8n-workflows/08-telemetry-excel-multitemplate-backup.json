      "id": "470564c8-849f-4319-91c1-4ce600271e13",
      "name": "Cari File di Folder Master",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        416,
        64
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "YOUR_DRIVE_CREDENTIAL_ID",
          "name": "YOUR_GOOGLE_CREDENTIAL_NAME"
        }
      }
