                  {
                      "id":  "normalize-input",
                      "name":  "Normalize Ingestion Source",
                      "parameters":  {
                                         "jsCode":  "const item = $json;\nlet fileId = \u0027\u0027;\nlet fileName = \u0027\u0027;\nlet mimeType = \u0027application/pdf\u0027;\nlet channel = \u0027Drive Dropzone\u0027;\nlet respondentEmail = \u0027\u0027;\nlet submitTimestamp = new Date().toISOString();\n\nif (item.body) {\n  // From Webhook (Google Form submit)\n  channel = \u0027Google Form\u0027;\n  const body = item.body;\n  fileId = body.drive_file_id || body.file_id || \u0027\u0027;\n  fileName = body.file_name || \u0027Tagihan_PLN.pdf\u0027;\n  mimeType = body.mime_type || \u0027application/pdf\u0027;\n  respondentEmail = body.respondent_email || \u0027\u0027;\n  submitTimestamp = body.submitted_at || submitTimestamp;\n} else if (item.id) {\n  // From Google Drive Trigger\n  channel = \u0027Drive Dropzone\u0027;\n  fileId = item.id;\n  fileName = item.name || \u0027Tagihan_PLN.pdf\u0027;\n  mimeType = item.mimeType || \u0027application/pdf\u0027;\n}\n\nif (!fileId) {\n  throw new Error(\u0027File ID tidak terdeteksi dari input.\u0027);\n}\n\nreturn {\n  json: {\n    channel,\n    file_id: fileId,\n    file_name: fileName,\n    mime_type: mimeType,\n    respondent_email: respondentEmail,\n    submitted_at: submitTimestamp\n  }\n};",
                                         "mode":  "runOnceForEachItem"
                                     },
                      "type":  "n8n-nodes-base.code",
                      "position":  [
                                       -160,
                                       20
                                   ],
                      "typeVersion":  2
                  },
                  {
                      "id":  "download-drive-file",
                      "name":  "Download File from Drive",
                      "parameters":  {
                                         "authentication":  "predefinedCredentialType",
                                         "method":  "GET",
                                         "options":  {

                                                     },
                                         "responseFormat":  "file",
                                         "url":  "=https://www.googleapis.com/drive/v3/files/{{ $json.file_id }}?alt=media\u0026supportsAllDrives=true",
                                         "nodeCredentialType":  "googleOAuth2Api"
                                     },
                      "credentials":  {
                                          "googleOAuth2Api":  {
                                                                  "id":  "google-oauth2-credentials",
                                                                  "name":  "Google Workspace OAuth2"
                                                              }
