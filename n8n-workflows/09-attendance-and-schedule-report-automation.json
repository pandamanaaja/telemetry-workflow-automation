      "position": [
        3152,
        640
      ]
    },
    {
      "parameters": {
        "jsCode": "// Set Periode 2 (16 - Akhir Bulan)\n// Bulan & tahun otomatis mengikuti data yang aktif di Master Spreadsheet\nreturn [{\n  json: {\n    action: 'create_absensi_file',\n    period: 'SECOND',\n    mode: 'PRODUCTION'\n  }\n}];"
      },
      "id": "2d0b6352-4d26-4d62-a1a6-e11b2c3843a1",
      "name": "Set Periode 2 (16 - Akhir Bulan)",
      "type": "n8n-nodes-base.code",
