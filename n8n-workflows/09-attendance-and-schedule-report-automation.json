    {
      "parameters": {
        "jsCode": "// Set Periode 1 (1 - 15)\n// Bulan & tahun otomatis mengikuti data yang aktif di Master Spreadsheet\nreturn [{\n  json: {\n    action: 'create_absensi_file',\n    period: 'FIRST',\n    mode: 'PRODUCTION'\n  }\n}];"
      },
      "id": "33227ec3-4078-42d0-9714-27b05f801ea1",
