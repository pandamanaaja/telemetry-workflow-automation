[Unit]
Description=PLN Standalone Report Python Fast-API Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/pln-report-service
Environment="PATH=/opt/pln-report-service/venv/bin"
Environment="PLN_API_SECRET_TOKEN=YOUR_STANDALONE_API_SECRET_TOKEN"
ExecStart=/opt/pln-report-service/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
